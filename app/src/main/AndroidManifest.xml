<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para reconocer "Este teléfono" en la lista de dispositivos por su IP en la red. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "¿Se llega desde fuera?": levantar los datos móviles sin dejar el Wi-Fi (requestNetwork). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android 17: hablar con el router (IPs privadas de la red local). Se pide al abrir la app. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
        usesCleartextTraffic: los routers OpenWrt sirven /ubus por HTTP en la LAN (HTTPS requiere
        un certificado autofirmado). Fuera de casa el tráfico irá dentro del túnel WireGuard.
        allowBackup=false: la contraseña cifrada no sirve en otro teléfono (la clave está en su Keystore).
    -->
    <application
        android:name=".WrtApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                El código QR con el que un teléfono añade a otro (wrtcontrol://connect?address=…&user=…).
                Solo rellena la pantalla de conexión, y solo con direcciones de red privada
                (data/Pairing.kt): la contraseña nunca va en el enlace.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wrtcontrol" android:host="connect" />
            </intent-filter>
        </activity>
    </application>
</manifest>
