    <string name="parental_newer_schema_title">Actualiza WrtControl para cambiar esto</string>
    <string name="parental_newer_schema_body">El control parental de este router lo configuró una versión más nueva de la app (quizá desde otro teléfono). Desde aquí puedes verlo, pero no cambiarlo: lo que esta versión no conoce se perdería.</string>
    <string name="parental_no_password_title">El router no tiene contraseña</string>
    <string name="parental_no_password_body">Cualquiera conectado a tu red puede abrir su configuración y quitar estas reglas.</string>
    <string name="parental_set_password">Poner contraseña</string>
    <string name="parental_rules_inactive_title">Las reglas de WrtControl no están activas</string>
    <string name="parental_rules_inactive_body">El firewall del router no tiene cargadas las reglas de los perfiles (quizá se reinició con un error o alguien borró el archivo). Vuelve a aplicarlas.</string>
    <string name="parental_reapply">Volver a aplicar</string>
    <string name="parental_zone_mismatch_title">La hora del router no coincide con la de este teléfono</string>
    <string name="parental_zone_mismatch_body">El router usa %1$s (%2$s) y el teléfono %3$s (%4$s). Los horarios se cuentan con la hora del router.</string>
    <string name="parental_zone_unknown">una zona desconocida</string>
    <string name="parental_use_phone_zone">Usar la zona del teléfono</string>
    <string name="parental_flow_offloading_title">Descarga de flujos activada</string>
    <string name="parental_flow_offloading_body">Con flow offloading, las conexiones que ya estaban abiertas pueden seguir hasta que se cierren aunque pauses, bloquees un servicio, quites una aprobación o bloquees el DNS cifrado. Las nuevas sí se bloquean.</string>
    <string name="parental_mark_conflicts_title">Otras reglas usan la misma marca</string>
    <string name="parental_mark_conflicts_body">Estas reglas del firewall cambian la marca 0x08000000 que usa WrtControl y podrían interferir con las pausas y horarios: %1$s.</string>
